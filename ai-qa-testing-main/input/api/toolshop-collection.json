    {
      "name": "09 - Obtener Detalle de Producto con ID Válido (GET /products/:id) [CP-API-018]",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.practicesoftwaretesting.com/products/{{sample_product_id}}",
          "protocol": "https",
          "host": ["api", "practicesoftwaretesting", "com"],
          "path": ["products", "{{sample_product_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('CP-API-018: Status code es 200 con un ID de producto existente', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('CP-API-018: Devuelve el producto solicitado', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.eql(pm.environment.get('sample_product_id'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "description": "ID tomado dinámicamente del primer producto devuelto por la request 01 (pm.environment 'sample_product_id'). Reemplaza el ID hardcodeado anterior, que ya no existía en el catálogo y siempre devolvía 404."
    },
