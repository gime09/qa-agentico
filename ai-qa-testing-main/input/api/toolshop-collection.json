{
  "info": {
    "name": "ToolShop API Test Suite",
    "_postman_id": "toolshop-v1-collection",
    "description": "Colección de pruebas para Practice Software Testing API. Cobertura completa de los 22 casos documentados en output/casos-api/casos-api-toolshop.md (CP-API-001 a CP-API-022).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Obtener Catálogo Completo (GET /products) [CP-API-009, CP-API-012]",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.practicesoftwaretesting.com/products",
          "protocol": "https",
          "host": ["api", "practicesoftwaretesting", "com"],
          "path": ["products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('CP-API-009: Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('CP-API-009: Retorna lista de productos paginada', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "    pm.expect(jsonData.data.length).to.be.greaterThan(0);",
              "});",
              "pm.test('CP-API-012: Endpoint es público (se accedió sin header Authorization)', function () {",
              "    pm.expect(pm.request.headers.has('Authorization')).to.eql(false);",
              "    pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.length > 0 && jsonData.data[0].id) {",
              "        pm.environment.set('sample_product_id', jsonData.data[0].id);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
