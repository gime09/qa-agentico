    {
      "name": "14 - Login Exitoso con Credenciales Válidas (POST /users/login) [CP-API-001, CP-API-008]",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
        },
        "url": {
          "raw": "https://api.practicesoftwaretesting.com/users/login",
          "protocol": "https",
          "host": ["api", "practicesoftwaretesting", "com"],
          "path": ["users", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('CP-API-001: Status code es 200 con credenciales válidas', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('CP-API-008: La respuesta incluye un campo con el token (string no vacío)', function () {",
              "    var jsonData = pm.response.json();",
              "    var token = jsonData.token || jsonData.access_token || jsonData.auth_token;",
              "    pm.expect(token, 'no se encontró token en la respuesta (campos probados: token, access_token, auth_token)').to.be.a('string').and.not.empty;",
              "});",
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    var token = jsonData.token || jsonData.access_token || jsonData.auth_token;",
              "    if (token) { pm.environment.set('auth_token', token); }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
